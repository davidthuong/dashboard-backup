# App
APP_NAME=Backup Job Dashboard
APP_HOST=0.0.0.0
APP_PORT=8000
TIMEZONE=Asia/Bangkok
DATABASE_URL=sqlite:///./backup_dashboard.db

# Admin account
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
SESSION_SECRET=replace_with_random_secret
SESSION_COOKIE_NAME=backup_dash_session
SESSION_MAX_AGE_SECONDS=43200
SESSION_COOKIE_SECURE=false

# Polling
POLLING_INTERVAL_SECONDS=60

# Veeam (VBR 12 REST API)
VEEAM_ENABLED=true
VEEAM_BASE_URL=https://veeam-server:9419
VEEAM_USERNAME=readonly_user
VEEAM_PASSWORD=readonly_password
VEEAM_VERIFY_SSL=false
VEEAM_TOKEN_URL=
# If empty, default: {VEEAM_BASE_URL}/api/v1/jobs/states
VEEAM_SESSIONS_URL=
VEEAM_TIMEOUT_SECONDS=20
# VBR 12 commonly uses 1.1-rev0 (adjust to your build if needed)
VEEAM_API_VERSION=1.1-rev0
# Optional multi-server JSON list. If set, app uses this instead of single VEEAM_* above.
# VEEAM_TARGETS_JSON=[{"name":"site-a","base_url":"https://vbr-a:9419","username":"u","password":"p","verify_ssl":false,"api_version":"1.1-rev0"},{"name":"site-b","base_url":"https://vbr-b:9419","username":"u2","password":"p2","sessions_url":"https://vbr-b:9419/api/v1/jobs/states","api_version":"1.1-rev0"}]
VEEAM_TARGETS_JSON=

# rclone logs (comma-separated, both Windows/Linux paths supported)
RCLONE_ENABLED=true
# Format supports:
# - node::path (local/mounted path)
# - node::ssh://user@host:22/var/log/rclone.log (hub pulls via SSH)
# Example: RCLONE_LOG_PATHS=win-file01::\\win-file01\logs\rclone-a.log,linux-bk01::ssh://root@10.10.10.21:22/var/log/rclone_da_backup.log
RCLONE_LOG_PATHS=C:\logs\rclone-job1.log,/var/log/rclone/job2.log
RCLONE_MAX_LINES_PER_FILE=5000

# DirectAdmin logs (optional)
DIRECTADMIN_ENABLED=false
# Supports node::path and node::ssh://user@host:22/path format like rclone
DIRECTADMIN_LOG_PATHS=/var/log/directadmin/backup.log
DIRECTADMIN_MAX_LINES_PER_FILE=5000

# Secure remote agent trigger (hub -> node)
AGENT_TRIGGER_ENABLED=false
AGENT_REQUEST_TTL_SECONDS=120
# JSON array:
# AGENT_NODES_JSON=[{"name":"win-bk01","url":"https://win-bk01.local:9189/collect","shared_secret":"change_me","verify_ssl":true,"timeout_seconds":15,"action":"rclone_log_push","payload":{"job_name":"nightly-share"}}]
# AGENT_NODES_JSON=[{"name":"linux-bk01","url":"http://10.10.10.21:9189/collect","shared_secret":"change_me_long_random","verify_ssl":false,"timeout_seconds":15,"action":"rclone_log_push","payload":{"job_name":"rclone-da","log_path":"/var/log/rclone_da_backup.log"}}]
# AGENT_NODES_JSON=[{"name":"win-icewarp-01","url":"http://win-icewarp-01:9189/collect","shared_secret":"change_me_long_random","verify_ssl":false,"timeout_seconds":20,"action":"backup_script_push","payload":{"job_name":"icewarp-nightly","backup_script_path":"D:\\scripts\\backup-icewarp.ps1","main_log_path":"D:\\scripts\\backup-icewarp.log"}}]
AGENT_NODES_JSON=

# Remote ingest (for servers that cannot share logs to central hub)
INGEST_ENABLED=true
INGEST_API_TOKEN=change_this_ingest_token

# Alert
ALERT_ENABLED=false
ALERT_MODE=telegram

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE=https://api.telegram.org

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=
ALERT_EMAIL_TO=
