APP_NAME=Backup Job Dashboard
APP_HOST=0.0.0.0
APP_PORT=8000
TIMEZONE=Asia/Bangkok
DATABASE_URL=sqlite:///./data/backup_dashboard.db

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_now
SESSION_SECRET=change_with_long_random_secret
SESSION_COOKIE_NAME=backup_dash_session
SESSION_MAX_AGE_SECONDS=43200
SESSION_COOKIE_SECURE=true

POLLING_INTERVAL_SECONDS=60

VEEAM_ENABLED=true
VEEAM_BASE_URL=
VEEAM_USERNAME=
VEEAM_PASSWORD=
VEEAM_VERIFY_SSL=false
VEEAM_TOKEN_URL=
VEEAM_SESSIONS_URL=
VEEAM_TIMEOUT_SECONDS=20
VEEAM_API_VERSION=1.1-rev0
VEEAM_TARGETS_JSON=

RCLONE_ENABLED=true
RCLONE_LOG_PATHS=
RCLONE_MAX_LINES_PER_FILE=5000

DIRECTADMIN_ENABLED=false
DIRECTADMIN_LOG_PATHS=
DIRECTADMIN_MAX_LINES_PER_FILE=5000

AGENT_TRIGGER_ENABLED=false
AGENT_REQUEST_TTL_SECONDS=120
AGENT_AUTO_TRIGGER_TIMES=
AGENT_NODES_JSON=

# Pull agents (nodes enroll from the dashboard: Agents > Add node)
AGENT_HUB_URL=https://backup.sys.bizmac.io
AGENT_HUB_CERT_SHA1=
AGENT_TLS_PROBE_ADDR=nginx:443
AGENT_ENROLL_TTL_MINUTES=1440
AGENT_OFFLINE_AFTER_MINUTES=10

INGEST_ENABLED=true
INGEST_API_TOKEN=change_this_ingest_token

ALERT_ENABLED=false
ALERT_MODE=telegram

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE=https://api.telegram.org

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=
ALERT_EMAIL_TO=
